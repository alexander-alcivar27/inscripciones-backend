// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Inscription {
  id Int @id @default(autoincrement())

  cedula          String   @unique
  nombres         String
  apellidos       String
  correo          String
  celular         String?
  fechaNacimiento DateTime

  ocupacion   String?
  institucion String?

  parroquiaId Int

  barrio String?

  genero             String
  orientacionSexual  String?
  nacionalidadId     Int
  autoidentificacion String?

  discapacidad     Boolean
  tipoDiscapacidad String?
  nivelEducacion   String

  createdAt    DateTime     @default(now())
  parroquia    Parroquia    @relation(fields: [parroquiaId], references: [id])
  nacionalidad Nacionalidad @relation(fields: [nacionalidadId], references: [id])
}

model Admin {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  password  String // bcrypt hash
  nombre    String?
  createdAt DateTime @default(now())

  @@map("admins")
}

model Provincia {
  id     Int    @id
  nombre String @map("provincia")

  cantones Canton[]

  @@map("Provincia")
}

model Canton {
  id     Int    @id
  nombre String @map("canton")

  provinciaId Int
  provincia   Provincia @relation(fields: [provinciaId], references: [id])

  parroquias Parroquia[]

  @@map("Canton")
}

model Parroquia {
  id     Int    @id
  nombre String @map("parroquia")

  cantonId Int
  canton   Canton @relation(fields: [cantonId], references: [id])

  inscriptions Inscription[]

  @@map("Parroquia")
}

model Nacionalidad {
  id         Int    @id @default(autoincrement()) // cambie id pasisNac int 
  paisNac    String @map("pais_nac")
  gentilicio String @map("gentilicio_nac")
  iso        String @map("iso_nac")

  inscriptions Inscription[]

  @@map("Nacionalidad")
}
